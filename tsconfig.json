{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["react"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["index.client.tsx", "client/**/*.tsx", "shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
