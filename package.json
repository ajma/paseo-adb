{
  "name": "paseo-adb",
  "version": "0.1.0",
  "description": "Manage Android Debug Bridge devices and QR pairing in Paseo.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajma/paseo-adb.git"
  },
  "homepage": "https://github.com/ajma/paseo-adb#readme",
  "bugs": {
    "url": "https://github.com/ajma/paseo-adb/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "adb",
    "android",
    "wear-os",
    "wireless-debugging"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "assets/",
    "docs/USAGE.md",
    "npm-shrinkwrap.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
